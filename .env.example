# TenderBrain ZM - Environment Variables
# Copy this to .dev.vars for local development

# LLM API (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional fallback LLM
OPENROUTER_KEY=

# WhatsApp Notifications (optional - if absent, WaMeOutboxProvider is used)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# OCDS Feed (default is Zambia ZPPA)
OCDS_URL=https://data.open-contracting.org/publication/3

# Admin credentials (first login)
ADMIN_EMAIL=admin@tenderbrain.co.zm
ADMIN_PASSWORD=changeme123

# DB binding name (should match wrangler.toml)
DB=tenderbrain-db
